# Copy this file to .env in the repository root. Never commit populated secrets.
# Loopback access is the default. For company-wide use, configure HTTPS below.
PUBLIC_ORIGIN=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
OPENRECONCILE_IMAGE=openreconcile:local
OPENRECONCILE_DATA_VOLUME=openreconcile_data
# Maximum login attempts per socket IP in 15 minutes (20–1000).
# A host reverse proxy shares this bucket between its users.
LOGIN_IP_LIMIT=100

# Unattended reconciliation runs in the standalone server, without a browser.
# false pauses automatic runs; manual runs remain available.
SCHEDULER_ENABLED=true
# How often the server checks due schedules (1–60 seconds).
SCHEDULER_POLL_SECONDS=5

# Bounded calculation threads shared by manual and scheduled runs.
# Workers: 1–4; queued calculations: 1–32; both timeouts: 1–300 seconds.
# Each worker has a 256 MB V8 old-generation heap limit (not total RSS).
CALCULATION_WORKERS=1
CALCULATION_QUEUE_LIMIT=8
CALCULATION_TIMEOUT_SECONDS=120
CALCULATION_QUEUE_TIMEOUT_SECONDS=30

# Company deployment example (TLS terminates at a reverse proxy):
# PUBLIC_ORIGIN=https://reconcile.company.internal

# Optional existing plant-side SQL gateway. It remains a separate service.
# Use a valid HTTPS certificate and the same token configured on that gateway.
SQL_GATEWAY_URL=
SQL_GATEWAY_TOKEN=

# Optional PI Web API connection profiles. Configure credentials and point
# allowlists in a private JSON file, then enable deploy/compose.pi.yaml.
# PI_CONNECTIONS_FILE_HOST=./deploy/pi-connections.json
# For a directly mounted server file, use its absolute container/server path:
PI_CONNECTIONS_FILE=
# A company CA can be mounted and trusted with NODE_EXTRA_CA_CERTS. Never
# disable certificate verification; see docs/pi-web-api.md for the mount.
