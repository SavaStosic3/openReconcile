# Production: configure ADMIN_EMAIL as a server runtime secret, never in browser code.
ADMIN_EMAIL=
# Loopback development uses the starter's simulated identity seedy@sites.test.
# Production: HTTPS endpoint of the separately deployed SQL gateway.
SQL_GATEWAY_URL=
# Secret shared with the gateway; 32-512 non-whitespace characters.
SQL_GATEWAY_TOKEN=
# Local tests only: allows HTTP to localhost/127.0.0.1/[::1]. Leave false in production.
SQL_GATEWAY_ALLOW_LOCAL=false
